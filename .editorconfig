root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,xml}]
indent_size = 2

[*.md]
# Markdown usa dois espaços no fim da linha como quebra forçada, e listas
# numeradas alinham a continuação ao marcador — não se impõe indentação aqui.
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
